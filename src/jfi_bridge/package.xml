<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jfi_bridge</name>
  <version>1.0.0</version>
  <description>Bridge node between path_manager and jfi_comm for swarm communication</description>
  <maintainer email="user@todo.todo">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>path_manager</depend>
  <depend>rclcpp_components</depend>

  <!-- Optional: JFI communication support (J-Fi submodule) -->
  <!-- This package only builds if jfi_comm is available -->
  <depend>jfi_comm</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
