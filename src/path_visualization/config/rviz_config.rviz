Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Marker  # (/path_markers)
      Enabled: true
      Name: Path and Obstacles
      Topic:
        Value: /path_markers
        Depth: 20
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Namespaces:
        path: true
        obstacle: true
      Alpha: 1.0
      Scale X: 0.1
      Scale Y: 0.1
      Scale Z: 0.1
    - Class: rviz_default_plugins/Marker  # (/V1/planning/trajectory)
      Enabled: true
      Name: Min Jerk Trajectory
      Topic:
        Value: /opt_trajectory
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.4
      Scale X: 0.05
      Scale Y: 0.05
      Scale Z: 0.05
      Color: 0;255;0
      History Length: 1000
    - Class: rviz_default_plugins/Marker  # (/V1/planning/global)
      Enabled: true
      Name: Global Trajectory
      Topic:
        Value: /global_trajectory
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.3
      Scale X: 0.05
      Scale Y: 0.05
      Scale Z: 0.05
      Color: 150;180;255
      History Length: 1000
    - Class: rviz_default_plugins/Marker  # (/position_markers_drone_0)
      Enabled: true
      Name: position_markers_drone_0
      Topic:
        Value: /position_markers_drone_0
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.8
      Scale X: 0.1
      Scale Y: 0.1
      Scale Z: 0.1
      Color: 255;0;0  # drone_0: 빨강
      History Length: 1000
    - Class: rviz_default_plugins/Marker  # (/position_markers_drone_1)
      Enabled: true
      Name: position_markers_drone_1
      Topic:
        Value: /position_markers_drone_1
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.8
      Scale X: 0.1
      Scale Y: 0.1
      Scale Z: 0.1
      Color: 0;255;0  # drone_1: 초록
      History Length: 1000
    - Class: rviz_default_plugins/Marker  # (/position_markers_drone_2)
      Enabled: true
      Name: position_markers_drone_2
      Topic:
        Value: /position_markers_drone_2
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.8
      Scale X: 0.1
      Scale Y: 0.1
      Scale Z: 0.1
      Color: 0;0;255  # drone_2: 파랑
      History Length: 1000

    - Class: rviz_default_plugins/Marker  # (/position_markers_drone_3)
      Enabled: true
      Name: position_markers_drone_3
      Topic:
        Value: /position_markers_drone_3
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.8
      Scale X: 0.1
      Scale Y: 0.1
      Scale Z: 0.1
      Color: 50;50;50  # drone_3: 회색
      History Length: 1000


    - Class: rviz_default_plugins/Marker  # (/position_markers_drone_4)
      Enabled: true
      Name: position_markers_drone_4
      Topic:
        Value: /position_markers_drone_4
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.8
      Scale X: 0.1
      Scale Y: 0.1
      Scale Z: 0.1
      Color: 50;50;50  # drone_3: 회색
      History Length: 1000

    - Class: rviz_default_plugins/Marker  # (/position_markers_drone_5)
      Enabled: true
      Name: position_markers_drone_5
      Topic:
        Value: /position_markers_drone_5
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.8
      Scale X: 0.1
      Scale Y: 0.1
      Scale Z: 0.1
      Color: 50;50;50  # drone_3: 회색
      History Length: 1000


    - Class: rviz_default_plugins/Marker  # (/drone_0/simple_path)
      Enabled: true
      Name: Simple Path Trajectory
      Topic:
        Value: /simple_path_trajectory
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Alpha: 0.7
      Scale X: 0.05
      Scale Y: 0.05
      Scale Z: 0.05
      Namespaces:
        opt_path_drone_0: true
        opt_path_drone_1: true
        opt_path_drone_2: true
        opt_path_drone_3: true
      Namespace Colors:
        opt_path_drone_0: 30;100;255
        opt_path_drone_1: 30;100;255
        opt_path_drone_2: 30;100;255
        opt_path_drone_3: 30;100;255
      History Length: 1000
    - Class: rviz_default_plugins/Marker  # (/road_boundary)
      Enabled: true
      Name: Road Boundary
      Topic:
        Value: /road_boundary
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Namespaces:
        road_boundary: true
      Alpha: 1.0
      Scale X: 0.3
      Scale Y: 0.3
      Scale Z: 0.3
    - Class: rviz_default_plugins/Marker  # (/risk_field)
      Enabled: true
      Name: Risk Field
      Topic:
        Value: /risk_field
        Depth: 50
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Namespaces:
        risk_field: true
      Alpha: 0.25
      Scale X: 1.0
      Scale Y: 1.0
      Scale Z: 1.0
      Color: 255;80;80
    - Class: rviz_default_plugins/Marker  # (/waypoint_markers)
      Enabled: true
      Name: Waypoint Markers
      Topic:
        Value: /waypoint_markers
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
      Namespaces:
        waypoints_drone_0: true
        waypoints_drone_1: true
        waypoints_drone_2: true
        waypoints_drone_3: true
      Namespace Colors:
        waypoints_drone_0: 255;0;0    # drone_0: 빨강
        waypoints_drone_1: 0;0;255    # drone_1: 파랑
        waypoints_drone_2: 0;255;0    # drone_2: 초록
        waypoints_drone_3: 255;255;0  # drone_3: 노랑
      Alpha: 1.0
      Scale X: 0.3
      Scale Y: 0.3
      Scale Z: 0.3
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Number of Cells: 50
      Plane: XY
      Color: 160;160;160
  Global Options:
    Background Color: 200;200;200
    # Background Color: 255;255;255 # white
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11.6418
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.42915
        Y: -1.579
        Z: 0.08014
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.625
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8014
Window Geometry:
  Displays:
    collapsed: false
  Height: 1524
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1950
  X: 870
  Y: 397